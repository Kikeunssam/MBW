rules_version = '2';
// 오르골당 짧은 공유 링크 (works/{8자 코드})
// - 코드를 아는 작품 하나만, 저장 후 24시간 동안 읽을 수 있다. 목록 보기·수정·삭제는 막는다.
// - 새 작품은 정해진 모양(d: 작품 문자열, e: 만료 시각, t: 서버 시각)과 크기로만 저장할 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /works/{code} {
      allow get: if resource.data.t + duration.value(24, 'h') > request.time;
      allow list, update, delete: if false;
      allow create: if code.matches('^[A-Za-z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['d', 'e', 't'])
        && request.resource.data.d is string
        && request.resource.data.d.size() > 0
        && request.resource.data.d.size() <= 100000
        && request.resource.data.t == request.time
        && request.resource.data.e is timestamp
        && request.resource.data.e > request.time
        && request.resource.data.e <= request.time + duration.value(25, 'h');
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
